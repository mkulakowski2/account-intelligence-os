{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OutreachPackage",
  "type": "object",
  "required": [
    "contact_name",
    "subject_a",
    "subject_b",
    "email_body",
    "linkedin_dm",
    "followups",
    "evidence_refs"
  ],
  "properties": {
    "contact_name": {
      "type": "string"
    },
    "subject_a": {
      "type": "string"
    },
    "subject_b": {
      "type": "string"
    },
    "email_body": {
      "type": "string"
    },
    "linkedin_dm": {
      "type": "string"
    },
    "warm_intro_request": {
      "type": "string"
    },
    "followups": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3
    },
    "evidence_refs": {
      "type": "array"
    }
  }
}
