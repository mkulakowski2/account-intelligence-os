{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AccountReport",
  "type": "object",
  "required": [
    "account_name",
    "executive_summary",
    "contacts",
    "use_cases",
    "outreach_packages",
    "sources_checked"
  ],
  "properties": {
    "account_name": {
      "type": "string"
    },
    "executive_summary": {
      "type": "string"
    },
    "contacts": {
      "type": "array"
    },
    "active_implementers": {
      "type": "array"
    },
    "use_cases": {
      "type": "array"
    },
    "outreach_packages": {
      "type": "array"
    },
    "sources_checked": {
      "type": "array"
    },
    "quality_gate": {
      "type": "object"
    }
  }
}
